pipeline {
    agent any
    
    tools {
        maven 'Maven3'
        jdk 'JDK17'
    }
    
    environment {
        TOMCAT_HOME     = '/opt/apache-tomcat-9.0.96'
        TOMCAT_WEBAPPS  = "${TOMCAT_HOME}/webapps"
        WAR_FILE        = 'lumiatech-v1.war'
        SLACK_CHANNEL   = '#jenkinscicd'
        APP_URL         = 'http://localhost:8081'
    }
    
    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Build Artifact') {
            steps {
                sh 'mvn clean package -DskipTests'
            }
            post {
                success {
                    echo '✓ Build successful!'
                    sh 'ls -lh target/*.war'
                }
            }
        }
        
        stage('Test') {
            steps {
                sh 'mvn test'
                // sh 'exit 1'
            }
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                }
            }
        }
                
        stage('Deploy to Tomcat') {
            steps {
                script {
                    echo 'Stopping Tomcat...'
                    sh 'sudo systemctl stop tomcat9 || true'
                    sleep 3
                    
                    echo 'Cleaning old deployment...'
                    sh """
                        sudo rm -rf ${TOMCAT_WEBAPPS}/ROOT
                        sudo rm -f  ${TOMCAT_WEBAPPS}/ROOT.war
                    """
                    
                    echo 'Deploying new WAR...'
                    sh """
                        sudo cp target/${WAR_FILE} ${TOMCAT_WEBAPPS}/ROOT.war
                        sudo chown tomcat:tomcat ${TOMCAT_WEBAPPS}/ROOT.war
                        sudo chmod -R 755 ${TOMCAT_WEBAPPS}
                    """
                    
                    echo 'Starting Tomcat...'
                    sh 'sudo systemctl start tomcat9'
                    sleep 10
                }
            }
            post {
                success {
                    echo '✓ Deployment successful!'
                }
                failure {
                    echo '✗ Deployment failed!'
                    sh 'sudo systemctl status tomcat9 || true'
                }
            }
        }
        
        stage('Health Check') {
            steps {
                script {
                    echo 'Checking Tomcat status...'
                    sh 'sudo systemctl is-active tomcat9'

                    echo 'Checking application response...'
                    def response = sh(
                        script: "curl -s -o /dev/null -w '%{http_code}' ${APP_URL}",
                        returnStdout: true
                    ).trim()

                    echo "HTTP Response Code: ${response}"

                    if (!(response in ['200', '302'])) {
                        error "Health check failed with HTTP ${response}"
                    }

                    echo 'Checking Spring initialization logs...'
                    sh """
                        sudo grep -i 'FrameworkServlet\\|WebApplicationContext.*initialized\\|Server startup' \
                        ${TOMCAT_HOME}/logs/catalina.out | tail -5 || true
                    """
                }
            }
        }
    }

    post {
        success {
            slackSend(
                channel: SLACK_CHANNEL,
                color: 'good',
                message: """\
                    ✅ *Pipeline Successful*
                    *Job:* ${env.JOB_NAME}
                    *Build:* #${env.BUILD_NUMBER}
                    *URL:* ${env.BUILD_URL}
                    🌍 App URL: ${APP_URL}
                    """
            )
        }
        
        failure {
            slackSend(
                channel: SLACK_CHANNEL,
                color: 'danger',
                message: """\
                    ❌ *Pipeline Failed*
                    *Job:* ${env.JOB_NAME}
                    *Build:* #${env.BUILD_NUMBER}
                    *URL:* ${env.BUILD_URL}
                    📄 Logs: ${TOMCAT_HOME}/logs/catalina.out
                    """
            )
        }

        always {
            cleanWs()
        }
    }
}
